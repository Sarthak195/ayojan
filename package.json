{
  "name": "celebration-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Celebration and event planner (working title).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check:size": "node scripts/check-file-size.mjs",
    "check:api": "node scripts/check-forbidden-apis.mjs",
    "check:repo": "node scripts/check-repo-size.mjs",
    "generate:ids": "tsx --conditions=react-server scripts/generate-ids.ts",
    "validate": "tsx --conditions=react-server scripts/validate-data.ts",
    "verify": "npm run typecheck && npm run lint && npm run validate && npm run test && npm run check:size && npm run check:api && npm run check:repo"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
