# In production this comes from Secret Manager via `gcloud run deploy --set-secrets`, never --set-env-vars.
# One key, or several separated by commas or whitespace. GEMINI_API_KEY_2, _3, ... are also read.
GEMINI_API_KEY=
# The 32-byte key, base64 encoded, that seals every plan link. Production refuses to start without
# it (Secret Manager secret state-seal-key); left empty locally, each process uses a random key.
STATE_SEAL_KEY=
